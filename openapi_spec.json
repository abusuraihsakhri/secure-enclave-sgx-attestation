{
  "openapi": "3.1.0",
  "info": {
    "title": "Secure Enclave Threshold Demonstrator API",
    "version": "3.0.1",
    "description": "A rule-based telemetry classification demonstrator. Does not perform SGX/SEV-SNP quote verification, cryptographic attestation, or HIPAA certification."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "SystemTaskPayload": {
        "type": "object",
        "required": [
          "task_id",
          "target_identifier",
          "primary_metric"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          "target_identifier": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          "primary_metric": {
            "type": "number"
          },
          "secondary_metric": {
            "type": "number",
            "default": 0
          },
          "status_descriptor": {
            "type": "string",
            "default": "NOMINAL"
          },
          "is_critical_flag": {
            "type": "boolean",
            "default": false
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true,
            "default": {}
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Process liveness and demonstration mode",
        "responses": {
          "200": {
            "description": "JSON process status"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Process-local JSON metrics",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "JSON counters"
          },
          "401": {
            "description": "Invalid API token"
          },
          "503": {
            "description": "API token not configured"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Run numerical/keyword rule evaluation, not SGX quote verification",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SystemTaskPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rule classification and in-memory chain hash"
          },
          "400": {
            "description": "Identifier screening rejected input"
          },
          "401": {
            "description": "Invalid API token"
          },
          "422": {
            "description": "Invalid payload"
          },
          "503": {
            "description": "API token not configured"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return deterministic mock response",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Mock response"
          },
          "400": {
            "description": "Input rejected"
          },
          "401": {
            "description": "Invalid API token"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Get process-local HMAC audit chain",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Audit entries and integrity status"
          },
          "401": {
            "description": "Invalid API token"
          }
        }
      }
    }
  }
}
